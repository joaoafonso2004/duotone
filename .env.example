# Copia este ficheiro para .env e preenche os valores.
# Ver GUIA-SETUP.md para instruções passo-a-passo de onde obter cada chave.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Spotify (developer.spotify.com -> Dashboard -> App -> Client ID)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxx

# YouTube Data API v3 (Google Cloud Console -> Credentials -> API Key)
EXPO_PUBLIC_YOUTUBE_API_KEY=AIza...
