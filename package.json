{
  "name": "duotone",
  "version": "1.4.1",
  "description": "A desktop-first music library and player for Windows.",
  "author": "Duotone",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "preweb:build": "npm run sync:desktop-version",
    "web:build": "expo export --platform web --output-dir dist-web",
    "sync:desktop-version": "node scripts/write-build-info.mjs",
    "desktop": "concurrently -k \"npm:web\" \"npm:desktop:host\"",
    "desktop:host": "wait-on http://localhost:8081 && electron electron/main.cjs",
    "desktop:build": "npm run web:build && electron-builder --win",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-mp4fixer.mjs && node scripts/test-artist-name.mjs && node --experimental-strip-types scripts/test-spotify-csv.ts && node --experimental-strip-types scripts/test-track-match.ts && node --experimental-strip-types scripts/test-search-query.ts && node --experimental-strip-types scripts/test-handoff.ts && node --experimental-strip-types scripts/test-player-lifecycle.ts && node --experimental-strip-types scripts/test-shuffle.ts && node --experimental-strip-types scripts/test-radio.ts && node --experimental-strip-types scripts/test-loudness.ts && node --experimental-strip-types scripts/test-listening-stats.ts && node --experimental-strip-types scripts/test-playback-diagnostics.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.13",
    "@supabase/supabase-js": "^2.50.0",
    "expo": "~57.0.2",
    "expo-auth-session": "~57.0.1",
    "expo-background-task": "~57.0.13",
    "expo-blur": "~57.0.0",
    "expo-brightness": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-clipboard": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.4",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-keep-awake": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-notifications": "~57.0.14",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-task-manager": "~57.0.13",
    "expo-video": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3",
    "wait-on": "^8.0.5"
  },
  "private": true,
  "build": {
    "appId": "com.joao.duotone.desktop",
    "productName": "Duotone",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist-web/**/*",
      "assets/icon.png",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
