{
  "expo": {
    "name": "Duotone",
    "slug": "duotone",
    "version": "5.7.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "duotone",
    "backgroundColor": "#060608",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#060608",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.joao.duotone",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "spotify"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true,
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.joao.duotone.continuar",
            "UIApplicationShortcutItemTitle": "Resume",
            "UIApplicationShortcutItemIconSymbolName": "play.fill"
          },
          {
            "UIApplicationShortcutItemType": "com.joao.duotone.mistura-do-dia",
            "UIApplicationShortcutItemTitle": "Daily mix",
            "UIApplicationShortcutItemIconSymbolName": "sparkles"
          },
          {
            "UIApplicationShortcutItemType": "com.joao.duotone.baralhar-gostadas",
            "UIApplicationShortcutItemTitle": "Shuffle Liked Songs",
            "UIApplicationShortcutItemIconSymbolName": "shuffle"
          }
        ]
      }
    },
    "android": {
      "package": "com.joao.duotone",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#060608"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "./plugins/atalhos-da-siri",
      "./plugins/velocidade-expo-video",
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-file-system",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite ao Duotone escolher a fotografia e a capa do teu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
